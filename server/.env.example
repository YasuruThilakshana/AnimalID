# AnimalID backend — copy to .env and fill in.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=2001@yasuruM
DB_NAME=animal_db
PORT=5000

# Meta AI SAM 3.1 (Meta Model API, server-side only — never expose to frontend).
# Requests go to POST {SAM_API_URL}/responses with model "sam-3.1".
# When SAM_API_KEY is empty or the API is unreachable, the server falls back to
# a deterministic local segmentation + embedding pipeline so scan still works.
SAM_API_KEY=
SAM_API_URL=https://api.meta.ai/v1

# Assistant chat (POST /api/assistant/chat) uses the same SAM_API_KEY
# against POST {SAM_API_URL}/responses with this chat model.
# Default is "muse-spark-1.3" (Meta's recommended multimodal model: text +
# image understanding) with one automatic retry on "muse-spark-1.2" if 1.3
# reports model_not_found. Set this to pin a specific model instead.
# Without a key it returns a helpful local fallback reply instead of live
# responses. The key is re-read per request, so adding it needs no restart.
ASSISTANT_MODEL=muse-spark-1.3
# Optional: pin a different vision-capable model for photo requests only.
# (Do NOT use muse-image-1.0 here — it generates images, it doesn't chat.)
# ASSISTANT_VISION_MODEL=muse-spark-1.3
# Optional: Meta API request timeout in ms (default 60000 text / 90000
# vision, capped at 300000). Raise on very slow networks to avoid aborts.
# ASSISTANT_TIMEOUT_MS=60000

# Photo scan tuning: the top SCAN_TOP_MATCHES candidates are always returned
# ranked by similarity (descending); scores at/above SCAN_MIN_SCORE (%) count
# as confident (valid) matches in the UI.
SCAN_MIN_SCORE=50
SCAN_TOP_MATCHES=3

# Secret used to sign auth tokens. Change this in production.
JWT_SECRET=change-me-in-production
