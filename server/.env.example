# AnimalID backend — copy to .env and fill in.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=2001@yasuruM
DB_NAME=animal_db
PORT=5000

# Meta AI SAM 3.1 embeddings API (server-side only — never expose to the frontend).
# When SAM_API_KEY is empty or the API is unreachable, the server falls back to
# a deterministic local embedding so scan still works in development.
SAM_API_KEY=
SAM_API_URL=https://api.meta.ai/sam/v3.1/embeddings

# Secret used to sign auth tokens. Change this in production.
JWT_SECRET=change-me-in-production
