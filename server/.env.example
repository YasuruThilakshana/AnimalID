# AnimalID backend — copy to .env and fill in.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=2001@yasuruM
DB_NAME=animal_db
PORT=5000

# Meta AI SAM 3.1 (Meta Model API, server-side only — never expose to frontend).
# Requests go to POST {SAM_API_URL}/responses with model "sam-3.1".
# When SAM_API_KEY is empty or the API is unreachable, the server falls back to
# a deterministic local segmentation + embedding pipeline so scan still works.
SAM_API_KEY=
SAM_API_URL=https://api.meta.ai/v1

# Photo scan tuning: the top SCAN_TOP_MATCHES candidates are always returned
# ranked by similarity (descending); scores at/above SCAN_MIN_SCORE (%) count
# as confident (valid) matches in the UI.
SCAN_MIN_SCORE=50
SCAN_TOP_MATCHES=3

# Secret used to sign auth tokens. Change this in production.
JWT_SECRET=change-me-in-production
